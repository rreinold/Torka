# Gemini API Key for text-to-image generation
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key for text-to-speech
# Get your key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenRouter API Key for AI analysis
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-4-340b-instruct
